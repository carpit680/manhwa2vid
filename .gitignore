# Downloaded reference material — keep the derived profile, not the source
reference/*.srt
reference/*.vtt
reference/*.mp4
reference/*.webm
reference/*.m4a
reference/*.wav
reference/*.log
reference/preview_page.html
reference/voice_lab*/
# Competitor corpus: downloaded third-party video/audio for measurement only.
# The rules above are top-level globs and do not reach reference/corpus/<label>/,
# so an unqualified `git add -A` would sweep in hundreds of MB of other people's
# video. The derived numbers live in reports/ and are what we actually keep.
reference/corpus/


# BGM audio is fetched, not versioned (see assets/bgm/ATTRIBUTION.md)
assets/bgm/*.mp3
assets/bgm/*.wav

# Local tool/agent configuration, not project code
.claude/
.agents/
skills-lock.json

# Human-review artifacts (A/B audio, listening tests) — not source
_review/

# A/B listening samples — regenerable, and mp3s do not belong in the repo.
samples/
