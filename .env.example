# LLM / VLM provider (groq | gemini | mistral | openai | ollama | mock)
LLM_PROVIDER=groq

# Groq — fastest, but the free tier caps TOKENS/day (200k ≈ 60 panels of vision)
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Gemini — free tier caps REQUESTS/day rather than tokens; best fit for image-heavy runs.
# NOTE: the 2.5 family now 404s ("no longer available to new users") — pin 3.x models.
# Key: https://aistudio.google.com/apikey  (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3-flash-preview

# Mistral — large monthly token allowance, low requests-per-minute ceiling
# Key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_TEXT_MODEL=mistral-large-latest
MISTRAL_VISION_MODEL=mistral-medium-latest

# TTS provider (chatterbox | openai | mock)
TTS_PROVIDER=chatterbox

# Optional: reference voice clip for Chatterbox voice cloning (~5-10s WAV)
# TTS_VOICE_PROMPT=assets/voices/narrator.wav

# OpenAI — only needed if TTS_PROVIDER=openai
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# Optional: DeepL translation polish
DEEPL_API_KEY=
